# EVEZ OpenClaw Environment — REDACTED for security 2026-07-29
# Actual keys stored in /root/.vault/ with 600 permissions

# === AUTH ===
OPENCLAW_AUTH_TOKEN=${VAULT}/openrouter.key

# === AI PROVIDERS ===
GROQ_API_KEY=${VAULT}/groq.key
