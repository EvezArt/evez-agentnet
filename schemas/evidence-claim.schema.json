{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evezart.github.io/evez-agentnet/schemas/evidence-claim.schema.json",
  "title": "EVEZ Evidence Claim",
  "type": "object",
  "required": ["claim_id", "subject", "predicate", "status", "source_type", "source_refs", "observed_at", "falsifier"],
  "properties": {
    "claim_id": {"type": "string", "minLength": 1},
    "subject": {"type": "string", "minLength": 1},
    "predicate": {"type": "string", "minLength": 1},
    "object": {},
    "status": {
      "type": "string",
      "enum": ["VERIFIED_PRIMARY","VERIFIED_LOCAL","REPORTED_SECONDARY","INFERRED","UNVERIFIED","CONTRADICTED","INVALID_METHOD","HISTORICAL_DRAFT"]
    },
    "source_type": {
      "type": "string",
      "enum": ["PRIMARY_RECORD","LOCAL_ARTIFACT","SECONDARY_REPORT","MODEL_INFERENCE","MEMORY","GENERATED_TEXT","UNKNOWN"]
    },
    "source_refs": {"type": "array", "items": {"type": "string"}},
    "observed_at": {"type": "string", "minLength": 1},
    "recorded_at": {"type": "string"},
    "independence": {"type": "string"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "falsifier": {"type": "string", "minLength": 1},
    "notes": {"type": "string"}
  }
}
