{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://evez.art/schemas/capability.schema.json",
  "title":"EVEZ Capability",
  "type":"object",
  "additionalProperties":false,
  "required":["id","name","lifecycle","interface","provenance","trust_state"],
  "properties":{
    "id":{"type":"string","pattern":"^cap_[a-z0-9._:-]+$"},
    "name":{"type":"string","minLength":1},
    "description":{"type":"string"},
    "domain":{"type":"string"},
    "provider":{"type":"string"},
    "version":{"type":"string"},
    "lifecycle":{"enum":["discovered","declared","permitted","tested","effective","composed","verified","published","deprecated","revoked"]},
    "interface":{
      "type":"object","additionalProperties":false,
      "required":["inputs","outputs"],
      "properties":{
        "inputs":{"type":"array","items":{"type":"string"}},
        "outputs":{"type":"array","items":{"type":"string"}},
        "protocol":{"type":"string"},
        "endpoint":{"type":["string","null"]}
      }
    },
    "preconditions":{"type":"array","items":{"type":"string"}},
    "permissions":{"type":"array","items":{"type":"string"}},
    "resource_cost":{"type":"object","additionalProperties":true},
    "side_effects":{"type":"array","items":{"type":"string"}},
    "reversibility":{"enum":["reversible","partially_reversible","irreversible","unknown"]},
    "provenance":{"type":"array","items":{"type":"string"}},
    "evidence_refs":{"type":"array","items":{"type":"string"}},
    "compatibility":{"type":"array","items":{"type":"string"}},
    "trust_state":{"enum":["unassessed","observed","supported","verified","contradicted","revoked"]},
    "expires_at":{"type":["string","null"],"format":"date-time"}
  }
}