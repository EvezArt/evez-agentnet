# EVEZ-OS Configuration Placeholders
# Generated by optimize-pack v3 setup
# Do not commit real secrets to repo - use environment at runtime

# ClawHub API token - rotate at https://clawhub.ai then set
# CLAWHUB_TOKEN=clh_your_rotated_token_here

# Supabase service_role JWT - rotate in Supabase dashboard then set
# SUPABASE_SERVICE_ROLE=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Revenue/Delivery channels - configure one or more
# TWITTER_BEARER_TOKEN=your_twitter_bearer_token
# GUMROAD_API_KEY=your_gumroad_api_key  
# MASTODON_BASE_URL=https://mastodon.social
# MASTODON_ACCESS_TOKEN=your_mastodon_access_token

# Payment vault - Stripe configuration (may incur costs)
# STRIPE_SECRET_KEY=your_stripe_secret_key
# STRIPE_ENDPOINT_SECRET=your_stripe_endpoint_secret

# OpenRouter model config (already optimized by pack v3)
OPENROUTER_PROVIDER=openrouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=nvidia/nemotron-3.5-lightning:free

# EVEZ internal services
EVEZ_OS_EVENT_SPINE_PORT=9116
EVEZ_OS_VOICE_PORT=9113
EVEZ_OS_GATEWAY_PORT=9001
EVEZ_OS_API_PORT=8192
